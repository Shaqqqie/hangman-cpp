{
    "version": 3,
    "configurePresets": [
        {
            "name": "ucrt64-debug",
            "displayName": "MSYS2 UCRT64 Debug",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
            }
        }
    ]
}